{
  "description": "Squish memory session lifecycle hooks",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "prompt",
            "prompt": "You have long-term memory from Squish loaded via MCP tools. Use squish context to load relevant memories from past sessions."
          },
          {
            "type": "command",
            "command": "${CODEX_PLUGIN_ROOT}/scripts/session-start.sh",
            "timeout": 30,
            "statusMessage": "Loading Squish memory context..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CODEX_PLUGIN_ROOT}/scripts/new-hook.js\"",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${CODEX_PLUGIN_ROOT}/scripts/save-hook.sh",
            "timeout": 15,
            "async": true,
            "statusMessage": "Saving checkpoint..."
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${CODEX_PLUGIN_ROOT}/scripts/precompact-hook.sh",
            "timeout": 30,
            "statusMessage": "Preserving memories before compaction..."
          }
        ]
      }
    ]
  }
}
