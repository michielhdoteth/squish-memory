# Squish Environment Configuration
# Copy this file to .env and customize as needed

# =============================================================================
# MODE (always local)
# =============================================================================
SQUISH_MODE=local

# Suppress startup banner and non-essential console output (default: false)
# SQUISH_QUIET=false

# =============================================================================
# SQLITE DRIVER FALLBACK (data-safety)
# =============================================================================
# If no native SQLite driver (bun:sqlite / better-sqlite3) can load, Squish
# refuses to start by default. sql.js rewrites the ENTIRE DATABASE FILE ON
# EVERY WRITE, which causes silent data corruption under concurrent processes.
# Only set this to true for single-process, read-mostly environments.
# SQUISH_ALLOW_SQLJS_FALLBACK=true

# =============================================================================
# LOCAL MODE DATA DIRECTORY
# =============================================================================
# A leading ~/ is expanded to your home directory. All MCP clients share the
# default ~/.squish unless explicitly overridden here.
SQUISH_DATA_DIR=./.squish

# Override project root detection (priority: SQUISH_WORKING_DIRECTORY > INIT_CWD > cwd)
# SQUISH_WORKING_DIRECTORY=

# =============================================================================
# DATABASE (team mode)
# =============================================================================
# Set a Postgres connection string to enable team mode (shared DB).
# When set, mode switches from 'local' to 'team' automatically.
# SQUISH_DATABASE_URL=postgresql://user:pass@host:5432/squish

# Auto-migrate database schema on startup (default: false)
# SQUISH_AUTO_MIGRATE=false

# =============================================================================
# MCP SERVER
# =============================================================================
SQUISH_MCP_PORT=8767
SQUISH_MCP_SERVER_ENABLED=false

# MCP transport mode: "stdio" (default) or "http"
# SQUISH_MCP_MODE=stdio
# Alias: setting SQUISH_MCP_HTTP=true forces HTTP mode
# SQUISH_MCP_HTTP=false

# CORS (comma-separated origins, * wildcard for port)
# SQUISH_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:8080

# =============================================================================
# EMBEDDINGS PROVIDER
# =============================================================================
# Options: local | openai | ollama | google | none | auto
# local = TF-IDF instantly at boot, then a real bundled model (all-MiniLM-L6-v2)
#         loads in the background and takes over. No API key needed.
# auto  = Try OpenAI > Ollama > Google > local fallback
SQUISH_EMBEDDINGS_PROVIDER=local

# Bundled local model loaded in the background by the "local" provider.
# Set to off to pin deterministic TF-IDF (offline evals, CI).
# SQUISH_LOCAL_BUNDLED_MODEL=Xenova/all-MiniLM-L6-v2
# SQUISH_LOCAL_BUNDLED_DTYPE=q8

# Vector scan candidate selection: full-corpus chunked scan or recency window.
# full scans every candidate row (complete recall); recency only sees the
# newest ~200 rows. Benchmark: scripts/bench-vector-scan.ts
# SQUISH_VECTOR_SCAN=full

# OpenAI (example: set both key and model)
# SQUISH_OPENAI_API_KEY=sk-...
# SQUISH_OPENAI_API_URL=https://api.openai.com/v1/embeddings
# SQUISH_OPENAI_EMBEDDING_MODEL=<openai-embedding-model>

# OpenAI per-provider timeout (default: inherits SQUISH_EMBEDDINGS_TIMEOUT_MS)
# SQUISH_OPENAI_TIMEOUT_MS=30000

# Ollama (example: set URL and model served by your local Ollama)
# SQUISH_OLLAMA_URL=http://localhost:11434
# SQUISH_OLLAMA_EMBEDDING_MODEL=<ollama-embedding-model>

# Ollama per-provider timeout (default: inherits SQUISH_EMBEDDINGS_TIMEOUT_MS)
# SQUISH_OLLAMA_TIMEOUT_MS=30000

# LM Studio (example: set URL and model loaded in LM Studio)
# SQUISH_LM_STUDIO_URL=http://localhost:1234
# SQUISH_LM_STUDIO_EMBEDDING_MODEL=<lm-studio-embedding-model>

# Transformers.js local (example: set a Hugging Face ONNX embedding model)
# SQUISH_LOCAL_MODEL=<huggingface-onnx-embedding-model>

# Google Cloud
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=us-central1
# GOOGLE_CLOUD_API_KEY=your-api-key
# Or use service account:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# SQUISH_GOOGLE_CLOUD_API_KEY=your-google-cloud-api-key
# SQUISH_GOOGLE_CLOUD_PROJECT=your-google-cloud-project
# SQUISH_GOOGLE_CLOUD_LOCATION=us-central1
# SQUISH_GOOGLE_EMBEDDING_MODEL=<google-embedding-model>

# Google per-provider timeout (default: inherits SQUISH_EMBEDDINGS_TIMEOUT_MS)
# SQUISH_GOOGLE_TIMEOUT_MS=30000

# Embedding reliability
SQUISH_EMBEDDINGS_TIMEOUT_MS=30000
SQUISH_EMBEDDINGS_MAX_RETRIES=3
SQUISH_EMBEDDINGS_RETRY_DELAY_MS=1000

# =============================================================================
# LLM GRAPH ENRICHMENT
# =============================================================================
# Optional LLM graph enrichment (off by default for launch-safe local mode)
SQUISH_LLM_ENABLED=false
# SQUISH_LLM_PROVIDER=openai
# SQUISH_LLM_ENDPOINT=http://localhost:1234
# SQUISH_LLM_EXTRACTION_MODEL=<llm-extraction-model>
# SQUISH_LLM_REASONING_MODEL=<llm-reasoning-model>
# SQUISH_LLM_API_KEY=your-llm-api-key
# SQUISH_LLM_MAX_TOKENS=300
# SQUISH_LLM_TEMPERATURE=0.1
# SQUISH_LLM_TIMEOUT_MS=10000

# Anthropic
# SQUISH_ANTHROPIC_API_KEY=your-anthropic-api-key
# SQUISH_ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Google Gemini
# SQUISH_GOOGLE_GEMINI_API_KEY=your-gemini-api-key
# SQUISH_GOOGLE_GEMINI_MODEL=gemini-2.0-flash

# =============================================================================
# QMD (local markdown search)
# =============================================================================
SQUISH_QMD_ENABLED=false
# SQUISH_QMD_COLLECTIONS=./qmd-collections
# SQUISH_QMD_FALLBACK=hybrid

# =============================================================================
# LIFECYCLE & MEMORY
# =============================================================================
SQUISH_LIFECYCLE_ENABLED=true
SQUISH_SUMMARIZATION_ENABLED=true
SQUISH_GOVERNANCE_ENABLED=true

# Lifecycle interval in ms (default: 3600000 = 1 hour)
# SQUISH_LIFECYCLE_INTERVAL=3600000

# Memory tier decay (v1.1.0+)
# Threshold for tier demotion: memories below this score get demoted (default: 0.1)
# SQUISH_DECAY_THRESHOLD=0.1
# Decay job cron schedule (default: hourly)
# SQUISH_LIFECYCLE_DECAY_CRON=0 * * * *

# Sector-specific decay intervals in days (v1.1.0+)
# SQUISH_DECAY_EPISODIC=30
# SQUISH_DECAY_SEMANTIC=90
# SQUISH_DECAY_PROCEDURAL=180
# SQUISH_DECAY_AUTOBIOGRAPHICAL=365
# SQUISH_DECAY_WORKING=7

# Summarization thresholds
# SQUISH_INCREMENTAL_THRESHOLD=10
# SQUISH_ROLLING_WINDOW_SIZE=50

# =============================================================================
# ENCRYPTION (v1.1.0+)
# =============================================================================
# Client-side AES-256-GCM encryption for memory content
# Set passphrase to enable encryption (requires existing memories to be re-encrypted)
# SQUISH_ENCRYPTION_PASSPHRASE=your-secure-passphrase

# Core memory limits (v0.9.2+)
# SQUISH_CORE_MEMORY_TOTAL_BYTES=16384
# SQUISH_CORE_MEMORY_SECTION_BYTES=4096

# =============================================================================
# SCORING WEIGHTS
# =============================================================================
# Composite scoring weights used in ranking. Adjust to tune recall behaviour.
# SQUISH_WEIGHT_RECENCY=0.5
# SQUISH_WEIGHT_RELEVANCE=3
# SQUISH_WEIGHT_IMPORTANCE=2
# SQUISH_WEIGHT_VECTOR_SIM=3
# SQUISH_WEIGHT_GRAPH_BOOST=0.10

# =============================================================================
# TIER MAINTENANCE THRESHOLDS
# =============================================================================
# Sturdy tier: memories accessed frequently enough within a window.
# SQUISH_STURDY_ACCESS_COUNT=5
# SQUISH_STURDY_ACCESS_WINDOW=30

# Long-term tier: memories older than this with sufficient importance.
# SQUISH_LONG_TERM_AGE=90
# SQUISH_LONG_TERM_IMPORTANCE=50

# Fleeting tier: low-importance memories that age out quickly.
# NOTE: the codebase currently reads SQUISH_FLETING_* (typo). Both spellings
# are documented here; the code uses SQUISH_FLETING_*. A future fix will
# normalize to SQUISH_FLEETING_*.
# SQUISH_FLETING_IMPORTANCE=25
# SQUISH_FLETING_AGE=60
# SQUISH_FLEETING_IMPORTANCE=25
# SQUISH_FLEETING_AGE=60

# =============================================================================
# GRAPH BOOST (v1.1.0+)
# =============================================================================
# Scoring weight for graph boost in recall (default: 0.10)
# Higher = more influence from memory associations
# SQUISH_WEIGHT_GRAPH_BOOST=0.10
# SQUISH_GRAPH_AUTO_BUILD=true
# SQUISH_GRAPH_EXTRACTION_METHOD=auto
# SQUISH_GRAPH_MAX_CONTENT_LENGTH=10000

# =============================================================================
# MANAGED MODE (Squish Cloud - paid tier)
# =============================================================================
# When enabled, MCP tools send memories directly to the cloud API.
# SQUISH_MANAGED_MODE=false
# SQUISH_MANAGED_API_URL=https://api.squish.dev
# SQUISH_MANAGED_API_KEY=your-api-key

# =============================================================================
# MCP HTTP AUTH (v1.3.0+)
# =============================================================================
# Set a key to require authentication for HTTP mode connections.
# SQUISH_MCP_API_KEY=your-mcp-api-key

# =============================================================================
# GRAPH HTML EXPORT (v1.3.0+)
# =============================================================================
# Auto-generates .squish/graph.html on graph builds (for non-Obsidian users)
# SQUISH_GRAPH_AUTO_EXPORT=false

# =============================================================================
# OPENCLAW GATEWAY
# =============================================================================
OPENCLAW_GATEWAY_ENABLED=false

# =============================================================================
# RETRIEVAL PRECISION STACK (Batches 0-5)
# =============================================================================
# Each flag is individually disableable with false/0/no/off.
# Cross-encoder rerank: ON by default, degrades gracefully when the model
# cannot load (timeout-capped).
# SQUISH_RERANKER_ENABLED=true
# SQUISH_RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
# SQUISH_RERANKER_LOAD_TIMEOUT_MS=10000
# SQUISH_RERANKER_TOP_K=20
# SQUISH_RERANKER_RETURN_TOP_K=10

# Query expansion: ON by default.
# SQUISH_QUERY_EXPANSION=true

# Temporal validity: OFF by default - the golden-eval gate showed a recall
# breach when enabled (flat staleness penalty is too blunt on aged corpora).
# Opt in explicitly.
# SQUISH_TEMPORAL_VALIDITY=false

# MMR diversity re-ranking.
# SQUISH_MMR_ENABLED=true
# SQUISH_MMR_LAMBDA=0.7
# SQUISH_MMR_TOP_K=10
# SQUISH_MMR_CANDIDATE_POOL=50

# Contextual retrieval prefixes and entity-aware retrieval.
# SQUISH_CONTEXTUAL_RETRIEVAL=true
# SQUISH_CONTEXTUAL_PREFIX_TEMPLATE=<your-template>
# SQUISH_ENTITY_RETRIEVAL=true

# Graph boost serving mode: legacy flat boost vs normalized neighbor walk.
# SQUISH_GRAPH_BOOST_LEGACY=false
# SQUISH_GRAPH_NEIGHBOR_BOOST=0.15

# =============================================================================
# RETRIEVAL SCORING (v1.5.0+)
# =============================================================================
# Fine-grained scoring adjustments for retrieval ranking.
# SQUISH_PLACE_BOOST=0.15
# SQUISH_TAG_OVERLAP_BOOST=0.10
# SQUISH_RECENCY_BOOST=0.03
# SQUISH_USAGE_BOOST=0.02
# SQUISH_CONTRADICTION_RISK_PENALTY=0.20
# SQUISH_PLACE_MIN_WEIGHT=0.35
# SQUISH_MIN_RESULTS=3
# SQUISH_TAG_CAP=12

# =============================================================================
# SCORING V2 + RECALL CONFIDENCE (Batch 6a)
# =============================================================================
# Serve v2 composite ranking; shadow mode logs v2 alongside without serving.
SQUISH_SCORING_V2=true
# SQUISH_SCORING_SHADOW=false

# Recall-confidence floor. When set, recall results whose best confidence is
# below the threshold get an honest no_reliable_memory verdict instead of
# weak hits (selective recall). Unset = always return best effort.
# SQUISH_ABSTAIN_BELOW=0.55

# Search beliefs alongside memories in hybrid retrieval.
SQUISH_SEARCH_BELIEFS=true

# Superseded handling in retrieval.
# SQUISH_INCLUDE_SUPERSEDED=true
# SQUISH_SUPERSEDED_PENALTY=0.5

# =============================================================================
# SECTORS, DECAY ENGINE, TIERS (Batch 6b)
# =============================================================================
# Signals-based sector routing (episodic|semantic|procedural|reflective) is
# automatic. One-time backfill of historical rows:
# SQUISH_SECTOR_BACKFILL_DRY_RUN=true

# Ebbinghaus decay engine (replaces sector-based decay).
# SQUISH_DECAY_ENGINE=v2

# Tier maintenance thresholds.
# SQUISH_DECAY_HOT_TIER_DAYS=7
# SQUISH_DECAY_COLD_TIER_DAYS=90

# =============================================================================
# FEEDBACK / REINFORCEMENT LOOP (Batch 6b)
# =============================================================================
# squish_feedback signals (confirm/used/contradict) adjust these echoes.
# SQUISH_FEEDBACK_TRACKING=true
# SQUISH_FEEDBACK_ECHO_BONUS=10
# SQUISH_FEEDBACK_FIZZLE_PENALTY=10

# =============================================================================
# DEDUP / MERGE WORKFLOW (Batch 6b)
# =============================================================================
# Nightly dedup_maintenance creates merge proposals for review via
# squish_dedup. Auto-execution of high-threshold merges is strictly gated
# (threshold and per-run cap are set on the dedup_maintenance job config).
SQUISH_DEDUP_AUTO=false

# =============================================================================
# ACL / VISIBILITY ENFORCEMENT (Batch 6b)
# =============================================================================
# Enforce visibility rules on memory reads (default: advisory only).
SQUISH_ACL_ENFORCE=false

# =============================================================================
# GEOMETRY-AWARE CONSOLIDATION (GAC)
# =============================================================================
# d_bar/d_eff geometry guards around cluster consolidation.
SQUISH_GEOMETRY_CONSOLIDATION=true
# SQUISH_GEOMETRY_THETA_PRIME=0.15
# SQUISH_GEOMETRY_AUTO_CONSOLIDATE=true
# SQUISH_GEOMETRY_AUTO_SPLIT=true
# SQUISH_GEOMETRY_MIN_CLUSTER_SIZE=3
# SQUISH_GEOMETRY_PRESERVE_PINNED=true

# =============================================================================
# CONSOLIDATION
# =============================================================================
# Merge similar memories automatically (default: false).
# SQUISH_CONSOLIDATION_ENABLED=false
# SQUISH_CONSOLIDATION_THRESHOLD=0.8

# LLM-powered consolidation: uses an LLM to decide which memories to merge.
# SQUISH_LLM_CONSOLIDATION_ENABLED=false
# SQUISH_LLM_CONSOLIDATION_BATCH_SIZE=50
# SQUISH_LLM_CONSOLIDATION_MIN_AGE_DAYS=7
# SQUISH_LLM_CONSOLIDATION_MIN_CONNECTIONS=2

# =============================================================================
# FEATURE FLAGS
# =============================================================================
# Isolate memories per-agent in team mode (default: true).
# SQUISH_AGENT_ISOLATION_ENABLED=true

# V2 contradiction check (default: false).
# SQUISH_V2_CONTRADICTION_CHECK=false

# External memory: load memories from an external JSONL file.
# SQUISH_EXTERNAL_MEMORY_ENABLED=false
# SQUISH_EXTERNAL_MEMORY_PATH=

# =============================================================================
# SESSION AUTO-LOAD
# =============================================================================
# Automatically load relevant past sessions on recall (default: true).
# SQUISH_SESSION_AUTO_LOAD=true
# Number of recent sessions to consider (default: 5).
# SQUISH_SESSION_AUTO_LOAD_RECENT_COUNT=5
# Minimum importance score to auto-load (default: 70).
# SQUISH_SESSION_AUTO_LOAD_IMPORTANCE_THRESHOLD=70

# =============================================================================
# QUERY REWRITING
# =============================================================================
# Rewrite queries using LLM context before retrieval (default: true).
# SQUISH_QUERY_REWRITING=true
# Number of recent context messages for rewriting (default: 5).
# SQUISH_QUERY_REWRITING_CONTEXT_MESSAGES=5
# Fall back to original query if rewriting fails (default: true).
# SQUISH_QUERY_REWRITING_FALLBACK=true

# =============================================================================
# SCHEDULER
# =============================================================================
# Scheduler mode: "cron" (default), "interval", or "heartbeat".
# SQUISH_SCHEDULER_MODE=cron
# Enable cron-based scheduling (default: true).
# SQUISH_CRON_ENABLED=true
# Heartbeat interval in ms (default: 60000 = 1 minute).
# SQUISH_HEARTBEAT_INTERVAL=60000
# Days to retain completed job records (default: 30).
# SQUISH_JOB_RETENTION_DAYS=30

# =============================================================================
# MAINTENANCE
# =============================================================================
# Nightly cleanup of stale/orphaned data (default: true).
# SQUISH_NIGHTLY_CLEAN=true
# Weekly memory consolidation pass (default: true).
# SQUISH_WEEKLY_CONSOLIDATION=true
# Monthly deep maintenance (default: false).
# SQUISH_MONTHLY_DEEP=false

# =============================================================================
# PLACES
# =============================================================================
# Use LLM to classify memories into place types (default: false).
# SQUISH_PLACE_LLM_CLASSIFICATION=false

# =============================================================================
# MULTIMODAL INGESTION
# =============================================================================
# Ingest non-text files (images, audio, etc.) from an inbox directory.
# SQUISH_MULTIMODAL_ENABLED=true
# SQUISH_MULTIMODAL_INBOX_DIR=./inbox
# SQUISH_MULTIMODAL_POLL_INTERVAL_MS=5000
# SQUISH_MULTIMODAL_MAX_FILE_SIZE_BYTES=104857600

# =============================================================================
# SYNC (team mode)
# =============================================================================
# Sync local memories to a shared server.
# SQUISH_SYNC_ENABLED=true
# SQUISH_SYNC_LOCAL_PATH=
# SQUISH_SYNC_AUTO_INTERVAL=300000
# SQUISH_SYNC_SERVER_HOST=localhost
# SQUISH_SYNC_SERVER_PORT=8768
# SQUISH_SYNC_TEAM_ID=default-team

# =============================================================================
# WIKI -> MEMORY ONE-TIME MIGRATION (Batch 8)
# =============================================================================
# The wiki subsystem was removed (db-only memory). On first boot after
# upgrade, legacy wiki_pages rows are migrated into memories tagged
# wiki-origin; resolvable [[wikilinks]] become graph associations; legacy
# tables are dropped. Set to true to preview counts without writing.
# SQUISH_WIKI_MIGRATE_DRY_RUN=true

# =============================================================================
# MAINTENANCE TOOL GATE
# =============================================================================
# Expose the squish_maintenance MCP tool (default off).
# SQUISH_ENABLE_MAINTENANCE_TOOLS=true

# =============================================================================
# AGENT DISABLE FLAGS
# =============================================================================
# Disable specific agent session stores (set to 1 to disable).
# When disabled, the agent store returns ok:false and is excluded from discovery.
# SQUISH_CLAUDE_DISABLED=1
# SQUISH_CODEX_DISABLED=1
# SQUISH_GEMINI_DISABLED=1
# SQUISH_OPENCODE_DISABLED=1

# =============================================================================
# CACHE
# =============================================================================
# LRU in-memory cache limits (used by core/storage/cache.ts).
# SQUISH_CACHE_MAX_ENTRIES=1000
# SQUISH_CACHE_MAX_BYTES=52428800

# =============================================================================
# RETRIEVAL -- ENTITY & MMR
# =============================================================================
# Entity-aware retrieval: enrich queries with named entities from context.
# SQUISH_ENTITY_RETRIEVAL=true

# MMR diversity re-ranking (candidate pool and top-k).
# SQUISH_MMR_TOP_K=10
# SQUISH_MMR_CANDIDATE_POOL=50

# Graph neighbor boost weight (separate from SQUISH_WEIGHT_GRAPH_BOOST).
# Controls the per-neighbor scoring contribution in normalized mode.
# SQUISH_GRAPH_NEIGHBOR_BOOST=0.15

# =============================================================================
# SEARCH EVIDENCE
# =============================================================================
# Freshness evidence signal: penalize stale memories in scoring.
# SQUISH_EVIDENCE_FRESHNESS=true
# Debug logging for evidence scoring (verbose output).
# SQUISH_EVIDENCE_DEBUG=false

# =============================================================================
# WEB UI
# =============================================================================
# Port for the optional web dashboard (default: 37777).
# SQUISH_WEB_PORT=37777
# API key to protect web UI endpoints.
# SQUISH_WEB_API_KEY=your-web-api-key

# =============================================================================
# BENCHMARK / DEBUG FLAGS
# =============================================================================
# Skip contradiction check during writes (useful for benchmark harness).
# SQUISH_SKIP_CONTRADICTION=false
