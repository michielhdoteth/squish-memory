# Files to exclude from npm package
node_modules/
.github/
.vscode/
.idea/

# Documentation (users can read README/CHANGELOG online)
docs/
*.md
MAP.md
**/MAP.md
PLAN.md
LOG.md
ROADMAP.md
!README.md
!CHANGELOG.md
!LICENSE


# Infrastructure
infra/
tests/
*.test.js
*.test.ts
*.spec.js
*.spec.ts

# Logs
*.log
npm-debug.log*
squish.log
squish-test.log

# Environment
.env*

# Temporary/cache
*.tmp
.cache/
coverage/
.nyc_output/
.carto/
**/.carto/
**/.carto/**
__pycache__/
**/__pycache__/
*.py[cod]
.DS_Store
Thumbs.db

# Package manager lock files (npm handles this)
bun.lock
bun.lockb
package-lock.json
yarn.lock

# Build artifacts (already included via dist/)
*.tgz
*.tar.gz

# Development only
features/
benchmark/
.sisyphus/
references/
opencode/

# Squish runtime data
.squish/
.opencode/
.test-data/
.test-data-*/
*.db
*.db-journal

# Internal planning / wiki
PLAN.md
plans/
wiki/
~/

# Generated files during development
generated/
squish-*.tgz
nul
NUL

# Source maps - not needed for consumers (reduces package size by ~1.3MB)
**/*.map
**/*.d.ts.map
