{
  "$schema": "./settings.schema.json",
  "version": "1.9.0",
  "data": {
    "dir": "~/.squish"
  },
  "mcp": {
    "serverPort": 8767,
    "serverEnabled": true,
    "mode": "stdio"
  },
  "database": {
    "type": "sqlite",
    "url": ""
  },
  "embeddings": {
    "enabled": true,
    "provider": "local",
    "timeout": 30000,
    "maxRetries": 3,
    "retryDelay": 1000,
    "models": {
      "openai": {
        "model": "",
        "apiUrl": "https://api.openai.com/v1/embeddings"
      },
      "google": {
        "model": "",
        "location": "us-central1"
      },
      "ollama": {
        "url": "http://localhost:11434",
        "model": ""
      },
      "lmstudio": {
        "url": "http://localhost:1234",
        "model": ""
      },
      "transformers": {
        "model": "",
        "device": "cpu"
      }
    }
  },
  "api": {
    "openai": {
      "apiUrl": "https://api.openai.com/v1/embeddings"
    },
    "google": {
      "location": "us-central1"
    },
    "ollama": {
      "url": "http://localhost:11434"
    },
    "lmstudio": {
      "url": "http://localhost:1234"
    }
  },
  "security": {
    "encryptionEnabled": false
  },
  "features": {
    "lifecycleEnabled": true,
    "summarizationEnabled": true,
    "agentIsolation": true,
    "governanceEnabled": true,
    "consolidationEnabled": false,
    "externalMemoryEnabled": false,
    "sessionAutoLoadEnabled": true,
    "queryRewritingEnabled": true,
    "queryRewritingFallbackEnabled": true,
    "feedbackTrackingEnabled": true,
    "writeDedup": "off",
    "writeDedupThreshold": 0.85,
    "writeDedupTopK": 5
  },
  "llm": {
    "enabled": false,
    "provider": "openai",
    "endpoint": "",
    "models": {
      "extraction": "",
      "reasoning": ""
    }
  },
  "decisionModel": {
    "layerEnabled": false,
    "modelEnabled": false,
    "backend": "llm",
    "provider": "auto",
    "systemone": {
      "provider": "ollaya",
      "baseUrl": "",
      "model": ""
    },
    "confidenceThreshold": 0.7,
    "routeTimeoutMs": 300,
    "classifyTimeoutMs": 1000
  },
  "promptGate": {
    "enabled": true,
    "modelEscalation": false,
    "timeoutMs": 300
  },
  "graph": {
    "autoBuild": true,
    "extractionMethod": "auto",
    "maxContentLength": 10000
  },
  "scoring": {
    "weights": {
      "recency": 0.5,
      "relevance": 3,
      "importance": 0,
      "vectorSim": 3,
      "graphBoost": 0.10
    }
  },
  "scheduler": {
    "mode": "cron",
    "cronEnabled": true,
    "heartbeatInterval": 60000,
    "jobRetentionDays": 30
  },
  "coreMemory": {
    "totalBytes": 16384,
    "sectionBytes": 4096
  }
}
