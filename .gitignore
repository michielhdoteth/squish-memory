# Dependencies
node_modules/
bun.lock
bun.lockb
package-lock.json
yarn.lock

# Build outputs
dist/
*.tgz
*.js.map
*.d.ts
*.d.ts.map

# Compiled JS (keep only source TS)
core/**/*.js
db/**/*.js
packages/*/src/**/*.js
config.js

# Environment
.env
.env.local
.env.production
.env.mcp

# Logs
*.log
npm-debug.log*
squish.log
squish-test.log

# OS files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Windows artifacts
NUL

# IDE
.vscode/
.idea/
.claude/
*.swp
*.swo
*~

# add-mcp generated configs
.mcp.json
opencode.json
.zed/
.cursor/
.codex/
.gemini/
config/mcporter.json

# OpenCode
.opencode/
