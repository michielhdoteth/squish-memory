# Dependencies
node_modules/
bun.lockb
package-lock.json
yarn.lock

# Build outputs
dist/
*.tgz
*.js.map
# Hand-written ambient declarations live in types/ and must be committed; the
# unanchored form above also swallowed them, which would leave the widened
# typecheck gate failing in CI while passing locally.
dist/**/*.d.ts
*.d.ts.map

# Compiled JS (keep only source TS)
core/**/*.js
db/**/*.js
cli/**/*.js
mcp/**/*.js
packages/*/src/**/*.js
config.js

# Environment
.env
.env.local
.env.production
.env.mcp

# Logs
*.log
npm-debug.log*
squish.log
squish-test.log

# OS files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Windows artifacts
NUL

# IDE
.vscode/
.idea/
.claude/
*.swp
*.swo
*~

# add-mcp generated configs
.mcp.json
opencode.json
.zed/
.cursor/
.codex/
.gemini/
config/mcporter.json

# OpenCode
.opencode/
.iter/

# Test coverage
coverage/
.nyc_output/

# Temporary files
tmp/
temp/
*.tmp

# Squish runtime data (project-local database and cache)
.squish/
*.db
*.db-journal
# SQLite WAL sidecars. *.db alone does not cover these, and they turn up next
# to any database a test or script creates. Committing them corrupts the db.
*.db-wal
*.db-shm

# Agent scratch (throwaway probes, scratch databases, session artifacts).
# Disposable by policy: see the workspace AGENTS.md scratch-area rules.
.workspace/

# Test data directories (never commit test artifacts)
.test-data/
.test-data-*/

# Planning docs (internal only, do not commit)
PLAN.md
LOG.md
ROADMAP.md
plans/
docs/specs/

# Local-only architecture maps and decision records.
MAP.md
**/MAP.md
docs/map.md
docs/ADR-*.md
docs/ACTION-EVALUATION.md
docs/MEMORY-SYSTEMS-RESEARCH.md
docs/PROFILE-BENCHMARK.md
docs/RETRIEVAL-ABLATIONS.md
docs/SDK-PLAN-HISTORY.md
docs/STRICT-MCP-TRUST-INVENTORY.md
docs/README.md
docs/GRAPH-EDGE-ATTESTATION.md
tests/benchmarks/reports/CONFIDENT-WRONG-AUTOPSY.md
docs/agent-memory-comparison.md
docs/calibration-report.md
docs/consolidation-bakeoff.md
docs/v2-scoring.md
AUDIT-CONSOLIDATED.md
FIXES-REQUIRED.md
GITHUB_RELEASE_*.md

# Wiki (root-local planning wiki only; anchored so source dirs like core/wiki are tracked)


# Home directory artifacts
~/

# References and opencode directories
references/
# Anchored: only a ROOT-level opencode/ dir is local-only. The unanchored
# pattern also matched plugins/opencode/, which left the in-repo OpenCode
# plugin unversioned (Batch 7 review, I-3). The tree moved plugin/ -> plugins/.
/opencode/
!plugins/opencode/

# Quick start guide (local only, do not commit)
QUICK-START.md

# Planning/launch docs generated during execution (keep local, do not commit)
.sisyphus/plans/squish-launch-100-ready.md
docs/MEMORY-SYSTEM.md
docs/MEMORY-GOVERNANCE.md
docs/MEMORY-LIFECYCLE.md
docs/COMPETITIVE-ANALYSIS.md
docs/POSITIONING.md
docs/ROADMAP.md

# Developer scripts (not part of published package)
dev-scripts/

# Test output artifacts (debug logs, raw test runner output, generated reports)
# These are generated at runtime and should never be committed.
# The benchmark suite moved from bench/ to benchmark/ (2026-11-07); the source
# is committed and only the generated artifacts are ignored.
test-*.txt
benchmark/runners/*.json
!benchmark/runners/*.ts
!benchmark/runners/*.mjs

# Root-level text dumps (test runner output captured to disk)
# NOTE: test-*.txt rule above must come BEFORE this *.txt rule.
*.txt
!LICENSE
!CHANGELOG.md
!README.md
!package.json
!server.json
!mcp.json.example
!fixed-error.txt

# Benchmark reports and run output — generated at runtime, not source.
# Keep only the release notes doc and the committed datasets; everything else
# is regenerated by the runners.
# A directory pattern (benchmark/reports/) cannot be re-included for a file
# underneath it, so the contents are globbed and the release notes doc is
# re-included above.
benchmark/reports/*
!benchmark/reports/v2.1.0-benchmark.md
benchmark/.bench-data/
benchmark/traces/
benchmark/RESULTS*.json
benchmark/RESULTS*.md
benchmark/RESULTS*.log
benchmark/RUN_PHASE*.log
benchmark/**/__pycache__/

# Agent configuration (local only, do not commit)
AGENTS.md

# Claude context file (local only, do not commit)
CLAUDE.md

# Generated MCP configs (local only)
generated/mcp/
benchmarks/

# Batch 9: the memory benchmark lives under tests/ and IS committed
# (fixtures + baseline report). The unanchored benchmarks/ rule above would
# otherwise exclude it.
!tests/benchmarks/
!tests/benchmarks/**
tests/benchmarks/reports/post-d09beac3-retrieval.json
tests/benchmarks/reports/post-d09beac3-memory-bench.json
tests/benchmarks/reports/post-cde0582-retrieval.json
tests/benchmarks/reports/post-cde0582-memory-bench.json
tests/benchmarks/reports/post-3015603-retrieval.json
tests/benchmarks/reports/post-3015603-memory-bench.json
tests/benchmarks/reports/CONFIDENT-WRONG-AUTOPSY.md

# Release artifacts
squish-v*-*.tar.gz
squish-v*-*.zip
release-assets/

# Internal references after broad public-document exceptions above.
/MAP.md
/docs/README.md
/docs/GRAPH-EDGE-ATTESTATION.md
/tests/benchmarks/MAP.md
/tests/benchmarks/**/MAP.md
# Local code-map cache generated by developer tooling.
.carto/
