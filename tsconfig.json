{
"compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noEmit": false,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false
  },
  "include": [
    "index.ts",
    "config.ts",
    "core/**/*.ts",
    "db/**/*.ts",
    "types/**/*.d.ts",
    "cli/**/*.ts",
    "mcp/**/*.ts",
    "bin/**/*.ts",
    "scripts/**/*.ts",
    "plugins/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", "tests", "bench", "benchmark", "docs", "squish-desktop"]
}
