{
  "name": "@squish/mcp",
  "version": "2.0.0",
  "description": "Squish MCP Server - Model Context Protocol Server",
  "type": "module",
  "main": "src/index.ts",
  "bin": {
    "squish-mcp": "../../bin/squish-mcp.mjs"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "tsx src/index.ts",
    "mcp:stdio": "tsx src/index.ts --stdio",
    "mcp:http": "tsx src/index.ts --http"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "@modelcontextprotocol/node": "^2.0.0",
    "@squish/core-sdk": "workspace:*",
    "zod": "^4.3.6",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^6.0.2"
  }
}
