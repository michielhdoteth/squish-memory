{
  "name": "@squish/core-sdk",
  "version": "2.1.0",
  "description": "Internal facade over the squish engine (workspace-only, never published)",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./types": {
      "import": "./src/types.ts",
      "types": "./src/types.ts"
    },
    "./interfaces/*": {
      "import": "./src/interfaces/*.ts",
      "types": "./src/interfaces/*.ts"
    }
  },
  "scripts": {
    "build": "tsc --noEmit",
    "test": "bun test",
    "clean": "rm -rf dist"
  },
  "license": "MIT",
  "devDependencies": {
    "bun-types": "latest",
    "typescript": "^6.0.2"
  }
}
