{
  "name": "@squish/sdk",
  "version": "2.1.0",
  "description": "Squish Memory SDK - typed API for building memory-powered applications",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./types": {
      "import": "./src/types.ts",
      "types": "./src/types.ts"
    },
    "./interfaces/*": {
      "import": "./src/interfaces/*.ts",
      "types": "./src/interfaces/*.ts"
    }
  },
  "files": [
    "src",
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "bun test",
    "clean": "rm -rf dist"
  },
  "license": "MIT",
  "dependencies": {},
  "peerDependencies": {
    "bun-types": ">=1.0.0"
  },
  "devDependencies": {
    "bun-types": "latest",
    "typescript": "^6.0.2"
  }
}
