{
  "name": "@squish/sdk",
  "version": "2.1.0",
  "description": "Squish Memory SDK - dependency-free TypeScript client for squish-memory over MCP streamable HTTP (local and cloud)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
